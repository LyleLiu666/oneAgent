      "number": 139,
      "title": "Feature request: 支持 OpenAI Responses API previous_response_id + 分支会话（rewind/fork）",
      "user": {
        "login": "RadonX",
        "id": 944393,
        "node_id": "MDQ6VXNlcjk0NDM5Mw==",
        "avatar_url": "https://avatars.githubusercontent.com/u/944393?v=4",
        "gravatar_id": "",
        "url": "https://api.github.com/users/RadonX",
        "html_url": "https://github.com/RadonX",
        "followers_url": "https://api.github.com/users/RadonX/followers",
        "following_url": "https://api.github.com/users/RadonX/following{/other_user}",
        "gists_url": "https://api.github.com/users/RadonX/gists{/gist_id}",
        "starred_url": "https://api.github.com/users/RadonX/starred{/owner}{/repo}",
        "subscriptions_url": "https://api.github.com/users/RadonX/subscriptions",
        "organizations_url": "https://api.github.com/users/RadonX/orgs",
        "repos_url": "https://api.github.com/users/RadonX/repos",
        "events_url": "https://api.github.com/users/RadonX/events{/privacy}",
        "received_events_url": "https://api.github.com/users/RadonX/received_events",
        "type": "User",
