<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.oneagent.fetch_agent_issues</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "__REPO_ROOT__" &amp;&amp; TOP_N=10 FOCUS_ONLY=1 docs/opensource/agent_issues/fetch_agent_issues.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Every 30 minutes (best-effort; pauses while the machine is asleep) -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <!-- Logs (repo-local runtime folder; ignored by git) -->
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/.oneagent/tmp/fetch_agent_issues.out</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/.oneagent/tmp/fetch_agent_issues.err</string>
</dict>
</plist>
